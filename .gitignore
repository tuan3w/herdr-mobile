# Release signing material must never be committed.
*.jks
*.keystore
key.properties

.DS_Store

# Python bytecode (the host plugin's tests create it)
__pycache__/
*.pyc

# Local helper scripts and reference clones of other projects (local/refs/<name>,
# `git clone --depth 1`), not part of the project
/local/

# Private writing the keyboard-prediction eval collects (tool/predict-eval)
tool/predict-eval/corpus/
