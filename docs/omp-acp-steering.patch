+	/**
+	 * `_session/steering`: queue a user message into the turn that is running right now.
+	 *
+	 * Answers `injected` when the session is streaming (an ACP-owned turn or an autonomous
+	 * one) and the message was handed to `AgentSession.prompt(..., { streamingBehavior: "steer" })`,
+	 * exactly like the TUI's Enter-while-streaming. Answers `promptRequired` when nothing is
+	 * running (or the running turn is being cancelled): no turn is started here because the
+	 * client would not be told when it ends, so it must send an ordinary `session/prompt`.
+	 * Never touches `promptTurn`, the prompt queue, or cancel state.
+	 */
+	async #steerSession(params: { [key: string]: unknown }): Promise<{ outcome: "injected" | "promptRequired" }> {
+		if (typeof params.sessionId !== "string" || !Array.isArray(params.prompt)) {
+			throw RequestError.invalidParams(undefined, "sessionId (string) and prompt (array) are required");
+		}
+		const record = this.#getSessionRecord(params.sessionId);
+		this.#throwIfRecordClosed(record);
+		const converted = this.#convertPromptBlocks(params.prompt as PromptRequest["prompt"]);
+		if (converted.text.length === 0 && converted.images.length === 0) {
+			throw RequestError.invalidParams(undefined, "prompt has no text or image content");
+		}
+		const promptTurn = record.promptTurn;
+		// A turn that is being cancelled still reports `isStreaming` until abort() lands, and abort
+		// drops anything queued meanwhile; let the client send a real prompt, which queues behind it.
+		if (!record.session.isStreaming || promptTurn?.cancelRequested || promptTurn?.cleanup !== undefined) {
+			return { outcome: "promptRequired" };
+		}
+		try {
+			await record.session.prompt(converted.text, {
+				streamingBehavior: "steer",
+				images: converted.images.length > 0 ? converted.images : undefined,
+			});
+		} catch (error) {
+			throw error instanceof AgentBusyError
+				? RequestError.sessionBusy(error.message, { reason: "session_busy", hint: "steer|followUp|wait" })
+				: error;
+		}
+		return { outcome: "injected" };
+	}
+
