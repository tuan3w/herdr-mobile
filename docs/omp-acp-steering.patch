+	describe("_session/steering", () => {
+		type PromptOptions = {
+			streamingBehavior?: string;
+			images?: Array<{ type: string; data: string; mimeType: string }>;
+		};
+
+		/** Starts a turn that stays in flight until the returned `finish` runs. */
+		async function startRunningTurn(harness: Awaited<ReturnType<typeof createHarness>>, sessionId: string) {
+			const session = harness.findSession(sessionId)!;
+			const steered: Array<{ text: string; options: PromptOptions | undefined }> = [];
+			const blockers: Array<() => void> = [];
+			session.prompt = async (text: string, options?: PromptOptions): Promise<boolean> => {
+				if (options?.streamingBehavior === "steer") {
+					steered.push({ text, options });
+					return true;
+				}
+				session.promptCalls.push(text);
+				session.isStreaming = true;
+				const { promise, resolve } = Promise.withResolvers<void>();
+				blockers.push(resolve);
+				await promise;
+				const assistantMessage = makeAssistantMessage("pong");
+				session.sessionManager.appendMessage(assistantMessage);
+				for (const listener of session.listeners()) {
+					listener({ type: "agent_end", messages: [assistantMessage] } as AgentSessionEvent);
+				}
+				session.isStreaming = false;
+				return true;
+			};
+			const abort = spyOn(session, "abort");
+			const turn = harness.agent.prompt({
+				sessionId,
+				messageId: "00000000-0000-4000-8000-0000000000a1",
+				prompt: [{ type: "text", text: "long running" }],
+			} as PromptRequest);
+			await Bun.sleep(0);
+			expect(session.promptCalls).toEqual(["long running"]);
+			return {
+				session,
+				steered,
+				abort,
+				turn,
+				finish: () => {
+					for (const resolve of blockers) resolve();
+				},
+			};
+		}
+
