+				AcpAgent["initialize"]
+			>[0]);
+			expect(response._meta).toEqual({ steering: { supported: true, idleBehaviors: ["promptRequired"] } });
+			harness.abortController.abort();
+			await Bun.sleep(0);
+		});
+
+		it("steers a running prompt turn without cancelling it and answers injected", async () => {
+			const harness = await createHarness();
