    <color name="ic_launcher_background">#0D0E10</color>
    <!-- Ds.paper.bg: the app's page colour, so launch shows no white flash.
         There is deliberately no values-night override: light is the app's
         default theme and the theme the person chose lives in Flutter's prefs,
